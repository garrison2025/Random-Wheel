
---
interface Props {kind?:'custom'|'numbers'|'letters'|'yesno'|'words'; min?:number; max?:number}
const {kind='numbers',min=1,max=100} = Astro.props;
const isLetters=kind==='letters';
const isYesNo=kind==='yesno';
const isWords=kind==='words';
const studioTitle=kind==='custom'?'The decision wheel':isLetters?'The alphabet wheel':isYesNo?'The Yes / No wheel':isWords?'The word wheel':'The number wheel';
const controlsTitle=kind==='custom'?'Make it yours.':isLetters?'Choose your letters.':isYesNo?'Choose your answers.':isWords?'Find your next word.':'Set your range.';
const intro=kind==='custom'?'Edit the list, pick a look and give your wheel a spin.':isLetters?'Pick the alphabet you need, leave out letters and choose fair results.':isYesNo?'Choose a 50/50 answer or include Maybe as a third equal option.':isWords?'Spin curated words, or create a personal word list for a game or writing prompt.':'Pick a range, exclude numbers and decide how to reveal the result.';
const lights=Array.from({length:32},(_,i)=>({x:(50+47.2*Math.sin(i*Math.PI/16)).toFixed(3),y:(50-47.2*Math.cos(i*Math.PI/16)).toFixed(3)}));
---
<div class="workbench" data-wheel-app data-kind={kind} data-min={min} data-max={max}>
  <section class="panel stage" id="start" aria-label="Random wheel studio">
    <div class="stage-head">
      <div class="stage-title-group">
        <span class="stage-symbol" aria-hidden="true">✳</span>
        <div><h2>{studioTitle}</h2><span class="hint" data-role="candidate-count">Ready to play</span></div>
      </div>
      <div class="stage-actions">
        <div class="palette-controls" role="group" aria-label="Wheel color scheme">
          <button type="button" data-palette="sunset" aria-pressed="true" style="--swatch:linear-gradient(135deg,#726bc4 48%,#72b3b3 52%)" title="Signature palette" aria-label="Signature palette"></button>
          <button type="button" data-palette="ocean" aria-pressed="false" style="--swatch:linear-gradient(135deg,#5980bc 48%,#8fc4bd 52%)" title="Coastal palette" aria-label="Coastal palette"></button>
          <button type="button" data-palette="candy" aria-pressed="false" style="--swatch:linear-gradient(135deg,#a28fb9 48%,#dfb0b8 52%)" title="Dusk palette" aria-label="Dusk palette"></button>
        </div>
        <button type="button" class="stage-icon-button" data-action="fullscreen" aria-label="Toggle fullscreen wheel" title="Fullscreen">⛶</button>
      </div>
    </div>
    <div class="stage-visual-tagline">THIS ONE IS UP TO CHANCE</div>
    <div class="wheel-wrap" data-role="wheel-wrap" aria-label="Animated random selection wheel">
      {lights.map(p=><span class="rim-light" aria-hidden="true" style={'left:'+p.x+'%;top:'+p.y+'%'}></span>)}
      <div class="wheel-disc" data-role="wheel-disc" aria-hidden="true"></div>
      <div class="wheel-pointer" aria-hidden="true"></div>
      <button type="button" class="wheel-center" data-action="center" aria-label="Start a random draw"><span class="wheel-center-inner"><span class="wheel-center-icon" aria-hidden="true">✦</span><span data-role="center-label">SPIN</span></span></button>
      <div class="wheel-overlay" data-role="wheel-overlay" aria-hidden="true">Every number included</div>
    </div>
    <div class="winner-sparks" data-role="winner-sparks" aria-hidden="true"></div>
    <p class="stage-caption">{kind==='custom'?'Tap the center or press Spin to reveal your next pick.':isLetters?'Every visible letter has an equal chance. Try vowels or consonants for word games.':isYesNo?'A fair Yes / No decision, or three equal outcomes when Maybe is included.':isWords?'Every active word has its own chance. Create a writing prompt or pick a word for your group.':'All eligible numbers are included—even when the wheel is visually simplified.'}</p>
    <a class="stage-edit-link" href="#wheel-settings">✎ Edit wheel options</a>
    <div class="result-card" role="status" aria-live="polite" aria-atomic="true">
      <div><div class="result-kicker">THE WINNER IS…</div><div class="result-value" data-role="result">Ready when you are</div></div>
      <span class="result-icon" aria-hidden="true">✴</span>
    </div>
    <div class="action-bar">
      <button class="primary" data-action="pick" type="button">✳ Spin the wheel</button>
      <button class="secondary" data-action="reset" type="button">↻ Start over</button>
    </div>
    <p class="feedback" role="status" data-role="feedback" aria-live="polite"></p>
    <div class="history" data-role="history" aria-label="Past results">Your recent picks will appear here.</div>
  </section>
  <section class="panel sidebar" id="wheel-settings" aria-label="Customize wheel">
    <div class="sidebar-title-wrap">
      <div><span class="sidebar-kicker">YOUR STUDIO</span><h2>{controlsTitle}</h2></div>
      <span style="font-size:24px;color:#6570c7" aria-hidden="true">✳</span>
    </div>
    <p class="sidebar-intro">{intro}</p>
    <div class="sidebar-label">01 — THE DRAW</div>
    <div class="segment" role="group" aria-label="Selection style">
      <button type="button" data-mode="quick" aria-pressed={kind==='numbers'?'true':'false'}>⚡ Quick pick</button>
      <button type="button" data-mode="spin" aria-pressed={kind==='numbers'?'false':'true'}>✳ Spin wheel</button>
    </div>
    <p class="option-help"><span>✦</span> Both modes use the same fair random draw.</p>
    <div class="field">
      <label for="speed-field">Spin duration</label>
      <select id="speed-field" data-role="speed">
        <option value="fast">Fast · 1.6 seconds</option>
        <option value="normal" selected>Normal · 3.6 seconds</option>
        <option value="slow">Slow · 5.5 seconds</option>
      </select>
    </div>
    {kind==='numbers'? (
      <>
        <div class="field">
          <div class="sidebar-label">02 — NUMBER RANGE</div>
          <div class="range-inputs">
            <div><label for="min-field">From</label><input id="min-field" data-role="min" inputmode="numeric" type="number" step="1" value={min}/></div>
            <div><label for="max-field">To</label><input id="max-field" data-role="max" inputmode="numeric" type="number" step="1" value={max}/></div>
            <div><label for="step-field">Step</label><input id="step-field" data-role="step" inputmode="numeric" type="number" min="1" step="1" value="1"/></div>
          </div>
          <p class="field-hint">Choose any range with up to 10,000 eligible values.</p>
          <div class="batch-row">
            <div class="field">
              <label for="batch-field">How many numbers?</label>
              <input id="batch-field" type="number" min="1" max="100" step="1" inputmode="numeric" data-role="batch" value="1"/>
            </div>
            <p class="field-hint">1–100 results per draw. Multiple results use instant selection; exclude repeats with the toggle below.</p>
          </div>
        </div>
        <div class="field">
          <label for="excluded-field">Exclude numbers <span style="font-weight:500;color:#9b979b">(optional)</span></label>
          <input id="excluded-field" data-role="excluded" type="text" placeholder="e.g. 4, 7, 12" autocomplete="off" />
          <p class="field-hint">Separate numbers with commas.</p>
        </div>
      </>
    ):isLetters?(
      <>
        <div class="field">
          <div class="sidebar-label">02 — LETTER SET</div>
          <label for="letter-set">Alphabet preset</label>
          <select id="letter-set" data-role="letter-set">
            <option value="all">A to Z · all 26 letters</option>
            <option value="vowels">Vowels · A E I O U</option>
            <option value="consonants">Consonants · 21 letters</option>
            <option value="game">Category game · common starting letters</option>
          </select>
        </div>
        <div class="field">
          <label for="letter-case">Letter case</label>
          <select id="letter-case" data-role="letter-case">
            <option value="upper">Uppercase · A B C</option>
            <option value="lower">Lowercase · a b c</option>
          </select>
        </div>
        <div class="field">
          <label for="letter-exclude">Leave out letters <span style="font-weight:500;color:#9b979b">(optional)</span></label>
          <input id="letter-exclude" data-role="letter-exclude" type="text" placeholder="Q, X, Z" inputmode="text" autocomplete="off" maxlength="180"/>
          <p class="field-hint">Comma-separated or typed together. No unavailable letters can be drawn.</p>
        </div>
        <div class="batch-row">
          <div class="field">
            <label for="batch-field">How many letters?</label>
            <input id="batch-field" data-role="batch" type="number" min="1" max="100" value="1" step="1" inputmode="numeric"/>
          </div>
          <p class="field-hint">Batch draws are immediate; enable Remove winners for distinct letters.</p>
        </div>
      </>
    ):isWords?(
      <>
        <div class="field">
          <div class="sidebar-label">02 — YOUR WORDS</div>
          <label for="word-category">Word collection</label>
          <select id="word-category" data-role="word-category">
            <option value="nouns">Everyday nouns · 16 words</option>
            <option value="verbs">Action verbs · 16 words</option>
            <option value="adjectives">Describing words · 16 words</option>
            <option value="classroom">Classroom prompts · 16 words</option>
            <option value="story">Story starters · 12 prompts</option>
            <option value="custom">My own words · editable list</option>
          </select>
          <p class="field-hint">Preset collections use equal chances; your custom list can use optional weights.</p>
        </div>
        <div class="word-custom-controls" data-role="word-custom-controls" hidden>
          <div class="field">
            <label for="word-custom">Your custom word list <span style="font-weight:500;color:#9b979b">(one per line)</span></label>
            <textarea id="word-custom" data-role="word-custom" spellcheck="false" rows="6">Sunshine
Adventure
Kindness
Discovery
Wonder
Harmony</textarea>
            <p class="field-hint">Add <strong>| 3</strong> after a word to triple its weight. Keep custom choices short enough to read in the wheel.</p>
          </div>
          <div class="field">
            <button type="button" class="secondary shuffle-action" data-action="shuffle">⤨ Shuffle custom list</button>
          </div>
          <div class="field">
            <label for="word-file">Import a list <span style="font-weight:500;color:#9b979b">(TXT or CSV)</span></label>
            <input id="word-file" type="file" data-role="file" accept=".txt,.csv,text/plain,text/csv"/>
          </div>
        </div>
        <div class="batch-row">
          <div class="field">
            <label for="batch-field">How many words?</label>
            <input id="batch-field" data-role="batch" type="number" min="1" max="100" value="1" step="1" inputmode="numeric"/>
          </div>
          <p class="field-hint">Draw up to 100 words. Enable Remove winners for unique results until the collection is exhausted.</p>
        </div>
      </>
    ):isYesNo?(
      <>
        <div class="field">
          <div class="sidebar-label">02 — THE ANSWERS</div>
          <label for="decision-mode">Decision options</label>
          <select id="decision-mode" data-role="decision-mode">
            <option value="yesno">Yes / No · 50% each</option>
            <option value="yesnomaybe">Yes / No / Maybe · 33.3% each</option>
          </select>
          <p class="field-hint">Each available answer has equal probability. This is a playful decision tool, not professional advice.</p>
        </div>
        <div class="decision-options" aria-hidden="true"><span>YES</span><span>NO</span><span class="maybe-chip">MAYBE</span></div>
      </>
    ):(
      <>
        <div class="field">
          <div class="sidebar-label">02 — THE CHOICES</div>
          <label for="entries-field">Entries <span style="font-weight:500;color:#9b979b">(one per line)</span></label>
          <textarea id="entries-field" data-role="entries" spellcheck="false">Alex
Jordan
Taylor
Morgan
Casey
Sam</textarea>
          <p class="field-hint">Give extra weight with <strong>| 3</strong> after a choice.</p>
        </div>
        <div class="template-picker" aria-label="Try a sample wheel">
          <button type="button" data-template="teams">4 teams</button>
          <button type="button" data-template="lunch">Lunch ideas</button>
          <button type="button" data-template="yesno">Yes / No</button>
        </div>
        <div class="field">
          <button type="button" class="secondary shuffle-action" data-action="shuffle">⤨ Shuffle entries</button>
        </div>
        <div class="field">
          <label for="csv-field">Import your list <span style="font-weight:500;color:#9b979b">(optional)</span></label>
          <input id="csv-field" type="file" data-role="file" accept=".txt,.csv,text/plain,text/csv"/>
        </div>
      </>
    )}
    <label class="switch-row" for="remove-field"><span>Remove winners after each draw</span><input data-role="remove" type="checkbox" id="remove-field"/></label>
    <div class="sidebar-label">03 — KEEP & SHARE</div>
    <div class="small-actions">
      <button type="button" class="secondary" data-action="save">▣ Save wheel</button>
      <button type="button" class="secondary" data-action="share">↗ Share setup</button>
      <button type="button" class="secondary" data-action="copy">▤ Copy results</button>
      <button type="button" class="secondary" data-action="export-csv">↓ Export CSV</button>
      <button type="button" class="secondary" data-action="export-txt">↓ Export TXT</button>
      <button type="button" class="secondary" data-action="clear">↺ Clear saved</button>
    </div>
    <div class="copy-block"><strong>Private, fair and free</strong><div>Your list stays in your browser. A shared link contains your options—avoid including personal information.</div></div>
    <div class="sidebar-footnote"><span class="dot"></span>No account. No uploads. Unlimited spins.</div>
  </section>
</div>
<script>import '../scripts/wheel.ts';</script>
