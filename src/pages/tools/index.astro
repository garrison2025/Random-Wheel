
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RANGE_PAGES } from '../../data/ranges';
const priority=[100,3,4,5,6,20];
const primaryRanges=priority.map(max=>RANGE_PAGES.find(page=>page.max===max)!).filter(Boolean);
// Show every range exactly once in the directory, including newly approved
// 1–8 and 1–30 pages that are not in the six featured cards.
const otherRanges=RANGE_PAGES.filter(page=>!priority.includes(page.max));
---
<BaseLayout path="/tools/" title="Free Random Wheel Tools" description="Explore Number Spinner free random tools: custom spin the wheel, random number wheel, quick number pickers and classroom number draws.">
  <section class="hero"><div class="container"><span class="eyebrow">Tools directory</span><h1>Free Random Wheel & Number Picker Tools</h1><p>Explore custom names, words, letters, Yes/No decisions or an exact number range—all free and private.</p></div></section>
  <section class="section"><div class="container">
    <div class="tool-grid">
      <a class="tool-card" href="/"><span class="icon-tile">✳</span><b>Spin the Wheel</b><p>Make a personalized wheel with your own choices and optional weights.</p><span class="go">Open tool →</span></a>
      <a class="tool-card" href="/random-number-wheel/"><span class="icon-tile">🎯</span><b>Random Number Wheel</b><p>Set a custom range, exclusions or step size.</p><span class="go">Open tool →</span></a>
      <a class="tool-card" href="/random-letter-wheel/"><span class="icon-tile" aria-hidden="true">AᐧZ</span><b>Random Letter Wheel</b><p>Spin A–Z, vowels or consonants, exclude letters and avoid repeats.</p><span class="go">Open alphabet wheel →</span></a>
      <a class="tool-card" href="/yes-or-no-wheel/"><span class="icon-tile" aria-hidden="true">Y/N</span><b>Yes or No Wheel</b><p>Try a fair 50/50 decision, or include Maybe as a third answer.</p><span class="go">Open Yes/No wheel →</span></a>
      <a class="tool-card" href="/random-word-wheel/"><span class="icon-tile" aria-hidden="true">Aa</span><b>Random Word Wheel</b><p>Ready-made word collections, custom lists and repeat-free random prompts.</p><span class="go">Spin a word →</span></a>
      {primaryRanges.map(page=><a class="tool-card" href={'/random-number-wheel/'+page.slug+'/'}><span class="icon-tile">🎲</span><b>Numbers 1–{page.max}</b><p>{page.example}</p><span class="go">Use preset →</span></a>)}
    </div>
    <section class="geo-tool-comparison" aria-labelledby="choose-picker">
      <h2 class="section-title" id="choose-picker">Which random picker should you use?</h2>
      <p class="section-intro">Choose by what you need to decide, not just by how the wheel looks. Every tool below uses browser-based random selection.</p>
      <div class="geo-choice-scroll" role="region" aria-label="Compare random picker tools" tabindex="0">
        <table class="geo-choice-table">
          <thead><tr><th scope="col">Your task</th><th scope="col">Best starting tool</th><th scope="col">What it does</th></tr></thead>
          <tbody>
            <tr><td>Choose from names, lunch ideas or other custom choices</td><td><a href="/">Custom Spin the Wheel</a></td><td>Edit the list and optionally assign weights; choose a quick or animated draw.</td></tr>
            <tr><td>Get one random integer from 1 to 100</td><td><a href="/random-number-wheel/1-100/">1–100 Number Picker</a></td><td>Instant result, with optional no-repeat batches and a visual wheel.</td></tr>
            <tr><td>Use die-style numbers, allowing the same number again</td><td><a href="/random-number-wheel/1-6/">1–6 Number Picker</a></td><td>Six equally eligible numbers for independent draws when Remove winners is off.</td></tr>
            <tr><td>Choose a numbered classroom participant</td><td><a href="/random-number-wheel/1-20/">1–20 Number Picker</a></td><td>Exclude absent numbers; remove winners if each present number should appear once.</td></tr>
            <tr><td>Choose your own minimum, maximum or step</td><td><a href="/random-number-wheel/">Custom Number Wheel</a></td><td>Up to 10,000 eligible integers and 1–100 results per draw.</td></tr>
          </tbody>
        </table>
      </div>
      <p class="geo-comparison-note">For probability rules, privacy and limitations, see <a href="/about/#how-results-are-generated">how the tools generate results</a>. These are everyday decision tools, not certified lottery services.</p>
    </section>
    <h2 class="section-title">More number range tools</h2>
    <p class="section-intro">These additional presets remain free to use. Open the exact range you need, or set any custom range in the main number wheel.</p>
    <div class="tool-grid">
      {otherRanges.map(page=><a class="tool-card" href={'/random-number-wheel/'+page.slug+'/'}><span class="icon-tile">🎲</span><b>Numbers 1–{page.max}</b><p>{page.example}</p><span class="go">Use preset →</span></a>)}
    </div>
  </div></section>
</BaseLayout>
