
---
import BaseLayout from '../layouts/BaseLayout.astro';
import Workbench from '../components/Workbench.astro';
import { RANGE_PAGES } from '../data/ranges';
---
<BaseLayout title="Free Spin the Wheel & Random Picker" description="Spin a free decision wheel with your own names and choices. Fair browser-based random results, weighted entries, no-repeat picks and no signup." path="/">
  <section class="hero">
    <div class="container">
      <div class="hero-copy">
        <span class="eyebrow">✳ A LITTLE RANDOMNESS GOES A LONG WAY</span>
        <h1>Spin the wheel.<br/><span class="highlight">Settle anything.</span></h1>
        <p>Names, decisions, lunch plans, team picks. Make your own colorful wheel and let chance do its thing.</p>
        <div class="hero-points"><span>Spin for free</span><span>No signup</span><span>Your list stays yours</span></div>
      </div>
      <div class="hero-side"><span class="badge-star" aria-hidden="true">✴</span><span><strong>100%</strong><br/>FREE TO PLAY</span></div>
    </div>
  </section>
  <div class="container main-overlap"><Workbench kind="custom"/></div>
  <section class="section">
    <div class="container">
      <span class="eyebrow">QUICK STARTS</span>
      <h2 class="section-title">Not sure where to start?</h2>
      <p class="section-intro">Skip the setup with our ready-to-use number pickers. Start with the range you want and spin.</p>
      <div class="tool-grid">
        <a class="tool-card" href="/random-number-wheel/"><span class="icon-tile" aria-hidden="true">✳</span><b>Random Number Wheel</b><p>Choose any custom number range with exclusions and steps.</p><span class="go">Make a number wheel ↗</span></a>
        {RANGE_PAGES.map(p=>(
          <a class="tool-card" href={'/random-number-wheel/'+p.slug+'/'}><span class="icon-tile" aria-hidden="true">#{p.max}</span><b>Pick a number 1–{p.max}</b><p>{p.example}</p><span class="go">Pick now ↗</span></a>
        ))}
      </div>
    </div>
  </section>
  <section class="section" style="padding-top:0">
    <div class="container article">
      <h2>The easiest way to make a fair pick</h2>
      <p>WheelCanvas turns small everyday decisions into something worth gathering around. Choose a class volunteer, set a meeting order, pick dinner or decide on an activity. Just add your options and spin.</p>
      <h3>How to use your wheel</h3>
      <p>Enter one choice per line, pick Quick Pick for a fast answer or Spin Wheel for a colorful reveal. Use Remove winners to avoid repeating results. Save the list locally in your browser for next time.</p>
      <h3>Are weighted entries supported?</h3>
      <p>Yes. Add <strong>| 3</strong> after an option to give it three times the weight of an option with weight 1. The wheel segments visually reflect their relative probability.</p>
      <h3>Does anything get uploaded?</h3>
      <p>The draw runs locally using your browser's secure randomness API. Your entries are not uploaded to our server. Sharing a setup embeds your options in the link, so avoid sensitive information.</p>
    </div>
  </section>
</BaseLayout>
