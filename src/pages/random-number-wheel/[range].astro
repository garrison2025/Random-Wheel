
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Workbench from '../../components/Workbench.astro';
import { RANGE_PAGES, type RangePage } from '../../data/ranges';
export function getStaticPaths(){
  return RANGE_PAGES.map(page=>({params:{range:page.slug},props:{page}}));
}
interface Props{page:RangePage}
const {page}=Astro.props;
const path='/random-number-wheel/'+page.slug+'/';
---
<BaseLayout noindex={page.indexApproved===false} path={path} title={page.title} description={page.description}>
  <section class="hero"><div class="container">
    <span class="eyebrow">Instant number picker · 1 to {page.max}</span>
    <h1>{page.headline}</h1>
    <p>{page.intro}</p>
    <div class="hero-points"><span>Fair, secure draw</span><span>Quick result or animation</span><span>All local—no login</span></div>
  </div></section>
  <div class="container main-overlap"><Workbench kind="numbers" min={1} max={page.max}/></div>
  <section class="section"><div class="container">
    <div class="article">
      <h2>What is the 1–{page.max} picker useful for?</h2>
      <p>{page.context}</p>
      <h3>How to pick between 1 and {page.max}</h3>
      <p>{page.guide}</p>
      <h3>Useful tip</h3>
      <p>{page.tip}</p>
      <h3>Is each number equally likely?</h3>
      <p>With all numbers included, step set to 1, and no exclusions, each of the {page.max} numbers has a 1 in {page.max} chance on a fresh draw. Excluding numbers or removing previous winners changes the set of available results for the next draw.</p>
      <h3>Can I use this without a wheel animation?</h3>
      <p>Yes. Quick Pick shows the result immediately. Choose Spin Wheel when you want a more visual reveal; for larger ranges the animation is simplified so the result is still selected from every eligible number.</p>
      <div class="related">
        <a href="/random-number-wheel/">Custom number range</a>
        <a href="/random-number-wheel/1-3/">1–3</a>
        <a href="/random-number-wheel/1-4/">1–4</a>
        <a href="/random-number-wheel/1-5/">1–5</a>
        <a href="/random-number-wheel/1-6/">1–6</a>
        <a href="/random-number-wheel/1-20/">1–20</a>
        <a href="/random-number-wheel/1-100/">1–100</a>
      </div>
    </div>
  </div></section>
</BaseLayout>
