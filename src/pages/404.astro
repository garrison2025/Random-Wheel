---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found (404)" description="This Number Spinner page could not be found. Go back to the free number picker, random wheel or tool directory." path="/404/" noindex={true}>
  <section class="hero"><div class="container">
    <span class="eyebrow">404 · PAGE NOT FOUND</span>
    <h1>That page isn't here.</h1>
    <p>The link may be outdated, or the URL may have been typed incorrectly. Your next random pick is only a click away.</p>
    <div class="hero-points"><span>Free number picker</span><span>Random wheel</span><span>No signup</span></div>
  </div></section>
  <section class="section"><div class="container article">
    <h2>Where would you like to go?</h2>
    <p>Start at the <a href="/">Number Spinner home page</a>, open the <a href="/random-number-wheel/">random number wheel</a>, or browse <a href="/tools/">all free tools</a>.</p>
    <p>If a link on our website sent you here, please <a href="/contact/">let us know</a> so we can fix it.</p>
  </div></section>
</BaseLayout>
